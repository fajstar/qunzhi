# ===== 复制本文件为 .env 并填入你的密钥（放在本文件同一目录，即项目根目录）=====
# 注意：未配置或填错时，系统仍可启动（页面正常打开），
#       但发起预演会返回 401；/health 接口会给出"配置缺失"提示。

# ---- 核心（必填）----
# DeepSeek API（6 人讨论引擎 + 完整报告生成 = 系统核心，与实验配置一致）
# 只需填 DEEPSEEK_API_KEY 一行即可（会自动用于双 Key 轮询负载均衡）；
# DEEPSEEK_API_KEY_2 为可选项，不填请整行删除，不要留 "sk-your-key-2-here" 这类占位符。
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_API_KEY_2=sk-your-key-2-here
DEEPSEEK_MODEL=deepseek-chat

# ---- 外围环节分流（可选；未配置或调用失败时自动回落 DeepSeek，不影响功能）----
# 人话化建议书 / 轻量任务 → Qwen（阿里云百炼，模型名用官方账号里可用的名称）
QWEN_API_KEY=your-qwen-key
QWEN_MODEL=qwen3.8-flash
# 深批者（对抗性评审）+ v3 评审中的实践者/审计员维度 → GLM（智谱）
# 注意：glm-5.3-flash 为推理模型（输出去 reasoning_content，content 可能为空），
#       本场景默认用非推理的 glm-4-flash（快、稳、直接出结果）。
GLM_API_KEY=your-glm-key
GLM_MODEL=glm-4-flash

# ---- 检索（可选）----
# 博查 Web 搜索（中文网络检索主源）
BOCHA_API_KEY=your-bocha-key

# ---- 学术检索说明（无需配置，开箱可用）----
# 知网：需要 cookies/cnki.json（登录态，由使用者自行导出，不随代码分发）；
#       缺失时自动跳过知网，不影响其它来源。
# Crossref / DOAJ / PubMed / OpenAlex / arXiv：全部免 Key，已内置，无需配置。
